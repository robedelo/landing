---
import { useTranslations, LANGUAGES } from "../i18n/utils";

interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang as keyof typeof LANGUAGES);

const links = [
    { name: t("nav.services"), href: "#services" },
    { name: t("nav.portfolio"), href: "#portfolio" },
    { name: t("nav.contact"), href: "#contact" },
];
---

<nav
    class="fixed w-full z-50 top-0 start-0 border-b border-white/10 bg-slate-950/80 backdrop-blur-md transition-all duration-300"
>
    <div
        class="max-w-7xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
        <a
            href={`/${lang}/`}
            class="flex items-center space-x-3 rtl:space-x-reverse group"
        >
            <span
                class="self-center text-2xl font-bold whitespace-nowrap text-white group-hover:text-blue-400 transition-colors"
                >Agency<span class="text-blue-500">.</span></span
            >
        </a>
        <div class="flex md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse">
            <div class="flex items-center space-x-2 mr-4">
                <a
                    href="/es/"
                    class={`text-sm font-medium ${lang === "es" ? "text-blue-400" : "text-gray-400 hover:text-white"} transition-colors`}
                    >ES</a
                >
                <span class="text-gray-600">|</span>
                <a
                    href="/en/"
                    class={`text-sm font-medium ${lang === "en" ? "text-blue-400" : "text-gray-400 hover:text-white"} transition-colors`}
                    >EN</a
                >
            </div>
            <button
                data-collapse-toggle="navbar-default"
                type="button"
                class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-400 rounded-lg md:hidden hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-600"
                aria-controls="navbar-default"
                aria-expanded="false"
            >
                <span class="sr-only">Open main menu</span>
                <svg
                    class="w-5 h-5"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 17 14"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 1h15M1 7h15M1 13h15"></path>
                </svg>
            </button>
        </div>
        <div
            class="hidden w-full md:block md:w-auto md:order-1"
            id="navbar-default"
        >
            <ul
                class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-gray-800 rounded-lg bg-gray-900 md:flex-row md:space-x-8 rtl:space-x-reverse md:mt-0 md:border-0 md:bg-transparent"
            >
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="block py-2 px-3 text-gray-300 rounded hover:bg-gray-800 md:hover:bg-transparent md:border-0 md:hover:text-blue-400 md:p-0 transition-colors duration-200"
                            >
                                {link.name}
                            </a>
                        </li>
                    ))
                }
                <li>
                    <a
                        href="#contact"
                        class="block py-2 px-4 text-white bg-blue-600 rounded-full hover:bg-blue-700 transition-colors duration-200 shadow-lg shadow-blue-500/30"
                        >{t("nav.getStarted")}</a
                    >
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    // Simple mobile menu toggle
    const btn = document.querySelector(
        '[data-collapse-toggle="navbar-default"]',
    );
    const menu = document.getElementById("navbar-default");

    if (btn && menu) {
        btn.addEventListener("click", () => {
            menu.classList.toggle("hidden");
        });
    }
</script>
