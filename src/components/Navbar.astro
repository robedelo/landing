---
import { useTranslations, LANGUAGES } from "../i18n/utils";
import esFlag from "../assets/flags/es.svg";
import enFlag from "../assets/flags/en.svg";

interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang as keyof typeof LANGUAGES);

const links = [
    { name: t("nav.services"), href: "#services" },
    { name: t("nav.portfolio"), href: "#portfolio" },
    { name: t("nav.contact"), href: "#contact" },
];

const currentFlag = lang === "es" ? esFlag : enFlag;
---

<nav
    class="fixed w-full z-50 top-0 start-0 border-b border-white/10 bg-slate-950/80 backdrop-blur-md transition-all duration-300"
>
    <div
        class="max-w-7xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
        <input type="checkbox" id="menu-toggle" class="hidden peer" />
        <a
            href={`/${lang}/`}
            class="flex items-center space-x-3 rtl:space-x-reverse group"
        >
            <span
                class="self-center text-2xl font-bold whitespace-nowrap text-white group-hover:text-blue-400 transition-colors"
            >
                Robedelo
            </span>
        </a>

        <div
            class="flex md:order-2 items-center space-x-3 md:space-x-0 rtl:space-x-reverse"
        >
            <!-- Language Selector -->
            <div class="relative ml-4 mr-4 md:mr-0 group">
                <button
                    class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-900/50 hover:bg-slate-800 transition-colors border border-white/10"
                >
                    <img
                        src={currentFlag.src}
                        alt={lang}
                        class="w-5 h-3.5 object-cover rounded-sm"
                    />
                    <span class="text-sm font-medium text-gray-300 uppercase"
                        >{lang}</span
                    >
                    <svg
                        class="w-4 h-4 text-gray-400 group-hover:rotate-180 transition-transform duration-200"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path></svg
                    >
                </button>
                <!-- Dropdown -->
                <div
                    class="absolute right-0 top-full pt-2 w-40 hidden group-hover:block group-focus-within:block z-50"
                >
                    <div
                        class="bg-slate-900 border border-white/10 rounded-lg shadow-xl"
                    >
                        <a
                            href="/es/"
                            class="flex items-center gap-3 px-4 py-3 hover:bg-slate-800 transition-colors first:rounded-t-lg border-b border-white/5"
                        >
                            <img
                                src={esFlag.src}
                                alt="Español"
                                class="w-5 h-3.5 object-cover rounded-sm"
                            />
                            <span class="text-sm text-gray-300">Español</span>
                        </a>
                        <a
                            href="/en/"
                            class="flex items-center gap-3 px-4 py-3 hover:bg-slate-800 transition-colors last:rounded-b-lg"
                        >
                            <img
                                src={enFlag.src}
                                alt="English"
                                class="w-5 h-3.5 object-cover rounded-sm"
                            />
                            <span class="text-sm text-gray-300">English</span>
                        </a>
                    </div>

                    <div
                        class="hidden w-full md:block md:w-auto md:order-1 peer-checked:block"
                        id="navbar-default"
                    >
                        <ul
                            class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-gray-800 rounded-lg bg-gray-900 md:flex-row md:items-center md:space-x-8 rtl:space-x-reverse md:mt-0 md:border-0 md:bg-transparent"
                        >
                            {
                                links.map((link) => (
                                    <li>
                                        <a
                                            href={link.href}
                                            class="block py-2 px-3 text-gray-300 rounded hover:bg-gray-800 md:hover:bg-transparent md:border-0 md:hover:text-blue-400 md:p-0 transition-colors duration-200"
                                        >
                                            {link.name}
                                        </a>
                                    </li>
                                ))
                            }
                            <li>
                                <a
                                    href="#contact"
                                    class="block py-2 px-4 text-white bg-blue-600 rounded-full hover:bg-blue-700 transition-colors duration-200 shadow-lg shadow-blue-500/30"
                                    >{t("nav.getStarted")}</a
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>
