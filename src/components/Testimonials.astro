---
import { useTranslations, LANGUAGES } from "../i18n/utils";

interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang as keyof typeof LANGUAGES);
---
<section class="py-24 bg-slate-950">
    <div class="max-w-screen-xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-16">
            {t("testimonials.title")}
        </h2>
        <div
            class="flex flex-wrap justify-center gap-12 md:gap-24 opacity-50 grayscale hover:grayscale-0 transition-all duration-500"
        >
            <!-- Simple Text Logos for now -->
            <span class="text-2xl font-bold text-white">ACME Corp</span>
            <span class="text-2xl font-bold text-white">GlobalTech</span
            >
            <span class="text-2xl font-bold text-white">Nebula</span>
            <span class="text-2xl font-bold text-white">FoxRun</span>
            <span class="text-2xl font-bold text-white">Circle</span>
        </div>
    </div>
</section>
