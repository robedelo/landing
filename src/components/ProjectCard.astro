---
interface Props {
    title: string;
    category: string;
    image: string;
    href?: string;
}

const { title, category, image, href = "#" } = Astro.props;
---

<a
    href={href}
    class="group relative block overflow-hidden rounded-2xl aspect-4/3 bg-slate-900"
>
    <img
        src={image}
        alt={title}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100"
    />
    <div
        class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/40 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-300"
    >
    </div>

    <div
        class="absolute bottom-0 p-6 w-full translate-y-2 group-hover:translate-y-0 transition-transform duration-300"
    >
        <span
            class="text-blue-400 text-sm font-medium uppercase tracking-wider mb-2 block"
            >{category}</span
        >
        <h3
            class="text-2xl font-bold text-white group-hover:text-blue-200 transition-colors"
        >
            {title}
        </h3>
    </div>
</a>
