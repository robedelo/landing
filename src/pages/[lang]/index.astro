---
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PricingPlans from "../../components/PricingPlans.astro";
import { getLangFromUrl, useTranslations, LANGUAGES } from "../../i18n/utils";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof LANGUAGES);

const services = [
    {
        title: t("services.items.design.title"),
        description: t("services.items.design.description"),
        icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>`,
    },
    {
        title: t("services.items.development.title"),
        description: t("services.items.development.description"),
        icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`,
    },
    {
        title: t("services.items.seo.title"),
        description: t("services.items.seo.description"),
        icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>`,
    },
];

const projects = [
    {
        title: t("portfolio.items.ecommerce.title"),
        category: t("portfolio.items.ecommerce.category"),
        image: "/no-image.svg",
    },
    {
        title: t("portfolio.items.portfolio.title"),
        category: t("portfolio.items.portfolio.category"),
        image: "/no-image.svg",
    },
    {
        title: t("portfolio.items.dashboard.title"),
        category: t("portfolio.items.dashboard.category"),
        image: "/no-image.svg",
    },
];
---

<Layout title="Agency - Premium Web Solutions" lang={lang}>
    <main>
        <!-- Hero Section -->
        <section
            class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20"
        >
            <div class="absolute inset-0 z-0">
                <div
                    class="absolute top-0 left-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"
                >
                </div>
                <div
                    class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl"
                >
                </div>
            </div>

            <div class="relative z-10 max-w-screen-xl mx-auto px-4 text-center">
                <span
                    class="inline-block py-1 px-3 rounded-full bg-blue-900/30 border border-blue-500/30 text-blue-400 text-sm font-medium mb-6 animate-fade-in-up"
                >
                    {t("hero.badge")}
                </span>
                <h1
                    class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tight leading-tight animate-fade-in-up delay-100"
                >
                    {t("hero.titlePrefix")}
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500"
                        >{t("hero.titleHighlight")}</span
                    >
                </h1>
                <p
                    class="text-xl text-gray-400 max-w-2xl mx-auto mb-10 animate-fade-in-up delay-200"
                >
                    {t("hero.description")}
                </p>
                <div
                    class="flex flex-col md:flex-row gap-4 justify-center animate-fade-in-up delay-300"
                >
                    <a
                        href="#contact"
                        class="px-8 py-4 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-1"
                    >
                        {t("hero.ctaStart")}
                    </a>
                    <a
                        href="#portfolio"
                        class="px-8 py-4 bg-slate-800 text-white rounded-full font-semibold hover:bg-slate-700 transition-all border border-slate-700 hover:border-slate-600"
                    >
                        {t("hero.ctaView")}
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="services" class="py-24 bg-slate-950 relative">
            <div class="max-w-screen-xl mx-auto px-4">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                        {t("services.title")}
                    </h2>
                    <p class="text-gray-400 max-w-xl mx-auto">
                        {t("services.subtitle")}
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>
            </div>
        </section>

        <!-- Portfolio Section -->
        <section id="portfolio" class="py-24 bg-slate-900/30">
            <div class="max-w-screen-xl mx-auto px-4">
                <div
                    class="flex flex-col md:flex-row justify-between items-end mb-12"
                >
                    <div>
                        <h2
                            class="text-3xl md:text-4xl font-bold text-white mb-4"
                        >
                            {t("portfolio.title")}
                        </h2>
                        <p class="text-gray-400 max-w-xl">
                            {t("portfolio.subtitle")}
                        </p>
                    </div>
                    <a
                        href="#"
                        class="text-blue-400 hover:text-blue-300 font-medium mt-4 md:mt-0 flex items-center group"
                    >
                        {t("portfolio.viewAll")}
                        <svg
                            class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                        >
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {projects.map((project) => <ProjectCard {...project} />)}
                </div>
            </div>
        </section>
        <PricingPlans/>
        <!-- Contact Section -->
        <section id="contact" class="py-24 relative overflow-hidden">
            <div class="absolute inset-0 bg-blue-900/10"></div>
            <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                    {t("contact.title")}
                </h2>
                <p class="text-xl text-gray-400 mb-10">
                    {t("contact.subtitle")}
                </p>
                <form class="max-w-md mx-auto space-y-4 text-left">
                    <div>
                        <label
                            for="email"
                            class="block text-sm font-medium text-gray-300 mb-1"
                            >{t("contact.emailLabel")}</label
                        >
                        <input
                            type="email"
                            id="email"
                            class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-slate-700 text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all"
                            placeholder={t("contact.emailPlaceholder")}
                        />
                    </div>
                    <div>
                        <label
                            for="message"
                            class="block text-sm font-medium text-gray-300 mb-1"
                            >{t("contact.messageLabel")}</label
                        >
                        <textarea
                            id="message"
                            rows="4"
                            class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-slate-700 text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all"
                            placeholder={t("contact.messagePlaceholder")}
                        ></textarea>
                    </div>
                    <button
                        type="submit"
                        class="w-full px-8 py-4 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/30"
                    >
                        {t("contact.submit")}
                    </button>
                </form>
            </div>
        </section>
    </main>
</Layout>

<style>
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    .delay-100 {
        animation-delay: 0.1s;
    }
    .delay-200 {
        animation-delay: 0.2s;
    }
    .delay-300 {
        animation-delay: 0.3s;
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
